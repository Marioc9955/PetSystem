<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="sequence_vet_appointment" model="ir.sequence">
        <field name="name">Pet Clinic Appointment</field>
        <field name="code">vet.appointment</field>
        <field name="prefix">PET%(year)s%(month)s%(day)s</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
