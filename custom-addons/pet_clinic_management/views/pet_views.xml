<odoo>
    <record id="vet_pet_kanban" model="ir.ui.view">
        <field name="name">vet.pet.kanban</field>
        <field name="model">vet.pet</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="name"/>
                <field name="pet_type"/>
                <field name="breed"/>
                <field name="owner_id"/>
                <field name="image"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="o_kanban_aside_full">
                            <field name="image" widget="image" class="w-100 h-100"
                                   options="{'img_class': 'object-fit-cover'}" alt="Pet image"/>
                        </aside>
                        <main class="ps-2">
                            <field name="name" class="fw-bold fs-5"/>
                            <div>
                                <span class="text-muted">Type:</span>
                                <field name="pet_type"/>
                            </div>
                            <div>
                                <span class="text-muted">Breed:</span>
                                <field name="breed"/>
                            </div>
                            <div>
                                <span class="text-muted">Owner:</span>
                                <field name="owner_id"/>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="vet_pet_form" model="ir.ui.view">
        <field name="name">vet.pet.form</field>
        <field name="model">vet.pet</field>
        <field name="arch" type="xml">
            <form string="Pet">
                <sheet>
                    <group>
                        <field name="image"/>
                        <field name="name"/>
                        <field name="pet_type"/>
                        <field name="breed"/>
                        <field name="age"/>
                        <field name="owner_id"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vet_pet_tree" model="ir.ui.view">
        <field name="name">vet.pet.tree</field>
        <field name="model">vet.pet</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="pet_type"/>
                <field name="breed"/>
                <field name="owner_id"/>
            </list>
        </field>
    </record>

    <record id="vet_pet_action" model="ir.actions.act_window">
        <field name="name">Pets</field>
        <field name="res_model">vet.pet</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem id="vet_clinic_root" name="Pet Clinic"
              groups="pet_clinic_management.group_vet_receptionist"/>
    <menuitem id="vet_pet_menu" name="Pets" parent="vet_clinic_root" action="vet_pet_action"
              groups="pet_clinic_management.group_vet_receptionist"/>
</odoo>
