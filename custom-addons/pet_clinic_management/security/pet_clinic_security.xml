<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_pet_clinic" model="res.groups.privilege">
        <field name="name">Pet Clinic</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_vet_receptionist" model="res.groups">
        <field name="name">Receptionist</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_pet_clinic"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_vet_veterinarian" model="res.groups">
        <field name="name">Veterinarian</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_pet_clinic"/>
        <field name="implied_ids" eval="[(4, ref('group_vet_receptionist'))]"/>
    </record>

    <record id="group_vet_administrator" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_pet_clinic"/>
        <field name="implied_ids" eval="[(4, ref('group_vet_veterinarian'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
